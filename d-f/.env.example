# PostgreSQL connection for the civic frontend database.
# Replace the example credentials locally; never commit a real connection string.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/app_db

# The browser-facing frontend API proxy connects to this backend origin.
GOVLINKS_API_URL=http://127.0.0.1:8080

# NVIDIA OpenAI-compatible chat and embeddings. Add your key to local .env only;
# keep it server-side and never prefix it with NEXT_PUBLIC_.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional vector retrieval; leave blank to use keyword retrieval.
# Configured embedding models must return 1024 dimensions to match the pgvector schema.
NVIDIA_EMBEDDING_MODEL=

# Optional Tavily official-source web search. Results are server-allowlisted.
TAVILY_API_KEY=

# Protect POST /api/assistant/index; use a long random secret and keep it private.
ASSISTANT_INDEX_TOKEN=
